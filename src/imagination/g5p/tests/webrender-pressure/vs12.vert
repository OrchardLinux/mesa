uniform highp sampler2D tex;uniform int uOffset;flat out vec4 v[8];
void main(){vec2 p=vec2((gl_VertexID<<1)&2,gl_VertexID&2);gl_Position=vec4(p*2.-1.,0,1);vec4 t0=texelFetch(tex,ivec2((0+uOffset)%64,0),0);vec4 t1=texelFetch(tex,ivec2((1+uOffset)%64,0),0);vec4 t2=texelFetch(tex,ivec2((2+uOffset)%64,0),0);vec4 t3=texelFetch(tex,ivec2((3+uOffset)%64,0),0);vec4 t4=texelFetch(tex,ivec2((4+uOffset)%64,0),0);vec4 t5=texelFetch(tex,ivec2((5+uOffset)%64,0),0);vec4 t6=texelFetch(tex,ivec2((6+uOffset)%64,0),0);vec4 t7=texelFetch(tex,ivec2((7+uOffset)%64,0),0);vec4 t8=texelFetch(tex,ivec2((8+uOffset)%64,0),0);vec4 t9=texelFetch(tex,ivec2((9+uOffset)%64,0),0);vec4 t10=texelFetch(tex,ivec2((10+uOffset)%64,0),0);vec4 t11=texelFetch(tex,ivec2((11+uOffset)%64,0),0);v[0]=(t0+t11)*.5;v[1]=(t1+t10)*.5;v[2]=(t2+t9)*.5;v[3]=(t3+t8)*.5;v[4]=(t4+t7)*.5;v[5]=(t5+t6)*.5;v[6]=(t6+t5)*.5;v[7]=(t7+t4)*.5;}